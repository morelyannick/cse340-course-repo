<%- include('partials/header') %>

<section class="page-hero">
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
</section>

<% if (projects.length > 0) { %>
    <ul class="project-list">
        <% projects.forEach(project => { %>
            <li class="project-card">
                <h2>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </h2>
                <p>
                    <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    }) %>
                </p>
                <% if (project.location) { %>
                    <p>Location: <strong><%= project.location %></strong></p>
                <% } %>
                <p>
                    Organization:
                    <strong>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </strong>
                </p>
            </li>
        <% }); %>
    </ul>
<% } else { %>
    <p>No service projects are currently available.</p>
<% } %>

<%- include('partials/footer') %>
