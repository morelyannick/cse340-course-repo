<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Service Project</a></p>
    <% } %>

    <% if (project.description) { %>
        <p><%= project.description %></p>
    <% } %>

    <p>
        Date:
        <%= new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC'
        }) %>
    </p>

    <p>Location: <strong><%= project.location %></strong></p>
    <p>
        Organization:
        <strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </strong>
    </p>

    <h2>Categories</h2>
    <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
    <% if (categories.length > 0) { %>
        <ul class="category-tags" aria-label="Project categories">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories are currently assigned to this project.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
