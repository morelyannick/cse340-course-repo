<%- include('partials/header') %>

<section class="page-hero">
    <h1><%= title %></h1>
    <p>Browse service project categories.</p>
</section>

<% if (categories.length > 0) { %>
    <ul class="project-list" aria-label="Service project categories">
        <% categories.forEach(category => { %>
            <li class="project-card"><%= category.category_name %></li>
        <% }); %>
    </ul>
<% } else { %>
    <p>No project categories are currently available.</p>
<% } %>

<%- include('partials/footer') %>